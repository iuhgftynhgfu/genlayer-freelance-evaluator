# Deployed address of the TaskEvaluator intelligent contract.
# Copy this file to `.env` and paste the address printed by the deployment
# step (`genlayer deploy` or the GenLayer Studio contract panel).
VITE_CONTRACT_ADDRESS=

# Optional: override the GenLayer RPC endpoint.
# Defaults to the official GenLayer Studio RPC.
VITE_GENLAYER_RPC_URL=

# Optional: which GenLayer network to talk to.
# One of: studionet | localnet | testnetBradbury | testnetAsimov
VITE_GENLAYER_CHAIN=studionet
